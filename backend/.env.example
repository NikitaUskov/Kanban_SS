APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=1.3.0
API_VERSION=v1
DATABASE_URL=sqlite:///C:/Kanban/data/kanban.db
JWT_SECRET=<generate-locally>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITATION_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=https://<owner>.github.io,http://127.0.0.1:5500,http://localhost:5500
LOG_LEVEL=INFO
LOG_DIR=C:/Kanban/logs
RUN_DIR=C:/Kanban/run
BACKUP_DIR=C:/Kanban/backups
GITHUB_PAGES_URL=https://<owner>.github.io/<repository>/
FRONTEND_URL=https://<owner>.github.io/<repository>/
REPOSITORY_PATH=C:/Kanban/repository
FRONTEND_REPOSITORY_PATH=C:/Kanban/repository
RUNTIME_CONFIG_PATH=frontend/runtime-config.json
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_MINUTES=10

# Email disabled by default. Invitations still provide a link for manual sending.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Kanban Board
